# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Feature Flags
VITE_ENABLE_MULTI_LEAGUE=false

# Development Configuration (optional - separate Supabase project for dev)
VITE_DEV_SUPABASE_URL=https://your-dev-project.supabase.co
VITE_DEV_SUPABASE_ANON_KEY=your-dev-anon-key-here

