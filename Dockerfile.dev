# Dev frontend container: installs deps once at build time; docker-compose.yml
# bind-mounts the repo over this for hot reload and keeps node_modules in its
# own anonymous volume so the Linux-built modules survive the mount.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
EXPOSE 5173
CMD ["npm", "run", "dev"]
