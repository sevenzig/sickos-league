# Server environment (copy to server/.env or set in compose)

# Postgres (superuser — migrations)
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres

# App role (RLS applies)
APP_DATABASE_URL=postgres://app_user:app_user@db:5432/postgres

# JWT signing secret — change in production
JWT_SECRET=local-dev-secret-change-me

# Local photo storage
PHOTOS_DIR=/data/photos

# SQL bootstrap + migrations directory
SQL_DIR=/app/db

PORT=3001

# Transactional email (optional — dry-run logs when unset)
RESEND_API_KEY=
EMAIL_FROM=BQBL <noreply@example.com>
APP_BASE_URL=http://localhost:5173
EMAIL_POLL_MS=30000

# Error tracking (optional — no-op when unset)
SENTRY_DSN=
